    {"name": "Create download URL", "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/users/{{userName}}/files/download?key=sandy%2Farchive%2Flogistics-report.pdf"}},
    {"name": "Reject other user's key", "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/users/sandy/files/download?key=alex%2Flogistics-invoice.xlsx"}}
  ]
